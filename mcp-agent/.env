# Copy to .env and fill in

# Spring Boot core (adjust port if you changed it)
BANK_API_URL=http://127.0.0.1:8081

# LiteLLM model names (as-is, passed straight to litellm.completion)
PRIMARY_MODEL=gemini/gemini-3.1-flash-lite
FALLBACK_MODEL=gemini/gemini-3.5-flash-lite

# Google AI Studio key  (get from https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_api_key_here


# MCP server transport (stdio for Claude Desktop, sse for web chat)
MCP_TRANSPORT=stdio
MCP_HOST=0.0.0.0
MCP_PORT=8000

# Gateway / chat server
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8290
